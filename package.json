{
  "name": "acme-colibri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "acmeproxy-compatible ACME DNS-01 proxy for Cloudflare Workers",
  "scripts": {
    "dev": "pnpm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "pnpm run build:web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply acme-colibri --local",
    "db:migrate:remote": "wrangler d1 migrations apply acme-colibri --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@11.26.0"
}
